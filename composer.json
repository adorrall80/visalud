{
    "name": "familia/portal-salud",
    "description": "Portal familiar para organizar atenciones, medicamentos y documentos de salud.",
    "type": "project",
    "require": {
        "php": "^8.2",
        "ext-pdo": "*",
        "google/apiclient": "^2.18",
        "dompdf/dompdf": "^3.1",
        "setasign/fpdi": "^2.6",
        "setasign/fpdf": "^1.8"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "files": [
            "app/Support/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    }
}
