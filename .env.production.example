APP_NAME="Portal Familiar de Salud"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://salud.ejemplo.cl
APP_TIMEZONE=America/Santiago
FORCE_HTTPS=true

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=portal_salud
DB_USERNAME=portal_salud_app
DB_PASSWORD=CAMBIAR_POR_CLAVE_SEGURA

GOOGLE_CLIENT_ID=CAMBIAR_CLIENT_ID
GOOGLE_CLIENT_SECRET=CAMBIAR_CLIENT_SECRET
GOOGLE_REDIRECT_URI=https://salud.ejemplo.cl/auth/google/callback

SESSION_NAME=portal_salud_session
SESSION_SECURE=true
MAX_UPLOAD_MB=10
LOG_RETENTION_DAYS=30
